<workout_file>
    <author>Coach Library</author>
    <name>Mixed L05A - Light Over-Unders 3x10 (95/85)</name>
    <description>Mixed - level 5 of 10, variant A. Light Over-Unders 3x10 (95/85).

Structure: 10 min warm-up, 5 x (1 min @ 95% / 1 min @ 85%), 4 min @ 55%, 5 x (1 min @ 95% / 1 min @ 85%), 4 min @ 55%, 5 x (1 min @ 95% / 1 min @ 85%), 7 min @ 60%, 5 min cool-down.

Coach notes: Gentle introduction to over-unders. Change only the gear between phases.

Estimated TSS: 57.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Mixed"/>
        <tag name="Level 5"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.75">
            <textevent timeoffset="0" message="Mixed session today. Warm up progressively."/>
        </Warmup>
        <IntervalsT Repeat="5" OnDuration="60" OffDuration="60" OnPower="0.95" OffPower="0.85">
            <textevent timeoffset="0" message="OVER: 1 min at 95%. Push, then settle back without stopping."/>
        </IntervalsT>
        <SteadyState Duration="240" Power="0.55">
            <textevent timeoffset="0" message="Recover: 4 min easy. Drink."/>
        </SteadyState>
        <IntervalsT Repeat="5" OnDuration="60" OffDuration="60" OnPower="0.95" OffPower="0.85">
            <textevent timeoffset="0" message="OVER: 1 min at 95%. Push, then settle back without stopping."/>
        </IntervalsT>
        <SteadyState Duration="240" Power="0.55">
            <textevent timeoffset="0" message="Recover: 4 min easy. Drink."/>
        </SteadyState>
        <IntervalsT Repeat="5" OnDuration="60" OffDuration="60" OnPower="0.95" OffPower="0.85">
            <textevent timeoffset="0" message="OVER: 1 min at 95%. Push, then settle back without stopping."/>
        </IntervalsT>
        <SteadyState Duration="420" Power="0.60">
            <textevent timeoffset="0" message="Main set done. 7 min of easy Zone 2 to finish."/>
        </SteadyState>
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
