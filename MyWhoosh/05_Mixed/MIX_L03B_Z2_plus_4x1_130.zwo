<workout_file>
    <author>Coach Library</author>
    <name>Mixed L03B - Z2 + 4x1 @ 130%</name>
    <description>Mixed - level 3 of 10, variant B. Z2 + 4x1 @ 130%.

Structure: 10 min warm-up, 15 min @ 72%, 4 x (1 min @ 130% / 4 min @ 60%), 10 min @ 72%, 5 min cool-down.

Coach notes: Zone 2 with four 1-minute anaerobic efforts at 130%. The ride stays aerobic overall.

Estimated TSS: 51.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Mixed"/>
        <tag name="Level 3"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.75">
            <textevent timeoffset="0" message="Mixed session today. Warm up progressively."/>
        </Warmup>
        <SteadyState Duration="900" Power="0.72">
            <textevent timeoffset="0" message="15 min at 72% - steady Zone 2. Conversational pace."/>
        </SteadyState>
        <IntervalsT Repeat="4" OnDuration="60" OffDuration="240" OnPower="1.30" OffPower="0.60">
            <textevent timeoffset="0" message="GO! 1 min at 130%. Commit from the first pedal stroke."/>
        </IntervalsT>
        <SteadyState Duration="600" Power="0.72">
            <textevent timeoffset="0" message="Recover: 10 min easy. Drink."/>
        </SteadyState>
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
