<workout_file>
    <author>Coach Library</author>
    <name>Mixed L09B - Threshold 2x10 @ 102% + 3x2 @ 120%</name>
    <description>Mixed - level 9 of 10, variant B. Threshold 2x10 @ 102% + 3x2 @ 120%.

Structure: 10 min warm-up, 10 min @ 102%, 4 min @ 55%, 10 min @ 102%, 4 min @ 55%, 3 x (2 min @ 120% / 2 min @ 50%), 5 min @ 60%, 5 min cool-down.

Coach notes: Supra-threshold first, then VO2max on tired legs. Save something for the 2-minute efforts.

Estimated TSS: 67.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Mixed"/>
        <tag name="Level 9"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.75">
            <textevent timeoffset="0" message="Mixed session today. Warm up progressively."/>
        </Warmup>
        <SteadyState Duration="600" Power="1.02">
            <textevent timeoffset="0" message="10 min at 102% - threshold. Pace it like a time trial."/>
        </SteadyState>
        <SteadyState Duration="240" Power="0.55">
            <textevent timeoffset="0" message="Recover: 4 min easy. Drink."/>
        </SteadyState>
        <SteadyState Duration="600" Power="1.02">
            <textevent timeoffset="0" message="10 min at 102% - threshold. Pace it like a time trial."/>
        </SteadyState>
        <SteadyState Duration="240" Power="0.55">
            <textevent timeoffset="0" message="Recover: 4 min easy. Drink."/>
        </SteadyState>
        <IntervalsT Repeat="3" OnDuration="120" OffDuration="120" OnPower="1.20" OffPower="0.50">
            <textevent timeoffset="0" message="GO! 2 min at 120%. Commit from the first pedal stroke."/>
        </IntervalsT>
        <SteadyState Duration="300" Power="0.60">
            <textevent timeoffset="0" message="Main set done. 5 min of easy Zone 2 to finish."/>
        </SteadyState>
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
