<workout_file>
    <author>Coach Library</author>
    <name>VO2max L05A - 5x4 @ 110%</name>
    <description>VO2max - level 5 of 10, variant A. 5x4 @ 110%.

Structure: 12 min warm-up, 5 x (4 min @ 110% / 4 min @ 50%), 8 min cool-down.

Coach notes: Five 4-minute intervals at 110%. Control the first 2 minutes.

Estimated TSS: 59.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="VO2max"/>
        <tag name="Level 5"/>
    </tags>
    <workout>
        <Warmup Duration="720" PowerLow="0.45" PowerHigh="0.75">
            <textevent timeoffset="0" message="VO2max session. Warm up thoroughly and add two 15 s accelerations in the last 3 minutes."/>
        </Warmup>
        <IntervalsT Repeat="5" OnDuration="240" OffDuration="240" OnPower="1.10" OffPower="0.50">
            <textevent timeoffset="0" message="GO! 4 min at 110%. Commit from the first pedal stroke."/>
        </IntervalsT>
        <Cooldown Duration="480" PowerLow="0.55" PowerHigh="0.40">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
