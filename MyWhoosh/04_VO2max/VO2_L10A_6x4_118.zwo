<workout_file>
    <author>Coach Library</author>
    <name>VO2max L10A - 6x4 @ 118%</name>
    <description>VO2max - level 10 of 10, variant A. 6x4 @ 118%.

Structure: 10 min warm-up, 6 x (4 min @ 118% / 3 min @ 50%), 2 min @ 60%, 6 min cool-down.

Coach notes: Six 4-minute intervals at 118% with 3-minute recoveries. The hardest VO2max session in the library.

Estimated TSS: 73.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="VO2max"/>
        <tag name="Level 10"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.75">
            <textevent timeoffset="0" message="VO2max session. Warm up thoroughly and add two 15 s accelerations in the last 3 minutes."/>
        </Warmup>
        <IntervalsT Repeat="6" OnDuration="240" OffDuration="180" OnPower="1.18" OffPower="0.50">
            <textevent timeoffset="0" message="GO! 4 min at 118%. Commit from the first pedal stroke."/>
        </IntervalsT>
        <SteadyState Duration="120" Power="0.60">
            <textevent timeoffset="0" message="Main set done. 2 min of easy Zone 2 to finish."/>
        </SteadyState>
        <Cooldown Duration="360" PowerLow="0.55" PowerHigh="0.40">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
