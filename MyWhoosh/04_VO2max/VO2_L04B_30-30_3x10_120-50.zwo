<workout_file>
    <author>Coach Library</author>
    <name>VO2max L04B - 30/30 3x10 (120/50)</name>
    <description>VO2max - level 4 of 10, variant B. 30/30 3x10 (120/50).

Structure: 12 min warm-up, 10 x (30 s @ 120% / 30 s @ 50%), 5 min @ 55%, 10 x (30 s @ 120% / 30 s @ 50%), 5 min @ 55%, 10 x (30 s @ 120% / 30 s @ 50%), 8 min cool-down.

Coach notes: Three sets of ten 30/30s. The off is soft-pedalling, not stopping.

Estimated TSS: 58.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="VO2max"/>
        <tag name="Level 4"/>
    </tags>
    <workout>
        <Warmup Duration="720" PowerLow="0.45" PowerHigh="0.75">
            <textevent timeoffset="0" message="VO2max session. Warm up thoroughly and add two 15 s accelerations in the last 3 minutes."/>
        </Warmup>
        <IntervalsT Repeat="10" OnDuration="30" OffDuration="30" OnPower="1.20" OffPower="0.50">
            <textevent timeoffset="0" message="GO! 30 s at 120%. Commit from the first pedal stroke."/>
        </IntervalsT>
        <SteadyState Duration="300" Power="0.55">
            <textevent timeoffset="0" message="Recover: 5 min easy. Drink."/>
        </SteadyState>
        <IntervalsT Repeat="10" OnDuration="30" OffDuration="30" OnPower="1.20" OffPower="0.50">
            <textevent timeoffset="0" message="GO! 30 s at 120%. Commit from the first pedal stroke."/>
        </IntervalsT>
        <SteadyState Duration="300" Power="0.55">
            <textevent timeoffset="0" message="Recover: 5 min easy. Drink."/>
        </SteadyState>
        <IntervalsT Repeat="10" OnDuration="30" OffDuration="30" OnPower="1.20" OffPower="0.50">
            <textevent timeoffset="0" message="GO! 30 s at 120%. Commit from the first pedal stroke."/>
        </IntervalsT>
        <Cooldown Duration="480" PowerLow="0.55" PowerHigh="0.40">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
