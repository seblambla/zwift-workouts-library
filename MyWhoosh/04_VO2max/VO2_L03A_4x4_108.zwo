<workout_file>
    <author>Coach Library</author>
    <name>VO2max L03A - 4x4 @ 108%</name>
    <description>VO2max - level 3 of 10, variant A. 4x4 @ 108%.

Structure: 12 min warm-up, 4 x (4 min @ 108% / 4 min @ 50%), 8 min @ 60%, 8 min cool-down.

Coach notes: Four 4-minute intervals at the bottom of the VO2 zone. Pace the first minute.

Estimated TSS: 53.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="VO2max"/>
        <tag name="Level 3"/>
    </tags>
    <workout>
        <Warmup Duration="720" PowerLow="0.45" PowerHigh="0.75">
            <textevent timeoffset="0" message="VO2max session. Warm up thoroughly and add two 15 s accelerations in the last 3 minutes."/>
        </Warmup>
        <IntervalsT Repeat="4" OnDuration="240" OffDuration="240" OnPower="1.08" OffPower="0.50">
            <textevent timeoffset="0" message="GO! 4 min at 108%. Commit from the first pedal stroke."/>
        </IntervalsT>
        <SteadyState Duration="480" Power="0.60">
            <textevent timeoffset="0" message="Main set done. 8 min of easy Zone 2 to finish."/>
        </SteadyState>
        <Cooldown Duration="480" PowerLow="0.55" PowerHigh="0.40">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
