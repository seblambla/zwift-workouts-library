<workout_file>
    <author>Coach Library</author>
    <name>VO2max L02B - 6x2 @ 115%</name>
    <description>VO2max - level 2 of 10, variant B. 6x2 @ 115%.

Structure: 12 min warm-up, 6 x (2 min @ 115% / 2 min @ 50%), 16 min @ 60%, 8 min cool-down.

Coach notes: Six 2-minute efforts with equal recovery. Short enough to go hard.

Estimated TSS: 51.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="VO2max"/>
        <tag name="Level 2"/>
    </tags>
    <workout>
        <Warmup Duration="720" PowerLow="0.45" PowerHigh="0.75">
            <textevent timeoffset="0" message="VO2max session. Warm up thoroughly and add two 15 s accelerations in the last 3 minutes."/>
        </Warmup>
        <IntervalsT Repeat="6" OnDuration="120" OffDuration="120" OnPower="1.15" OffPower="0.50">
            <textevent timeoffset="0" message="GO! 2 min at 115%. Commit from the first pedal stroke."/>
        </IntervalsT>
        <SteadyState Duration="960" Power="0.60">
            <textevent timeoffset="0" message="Main set done. 16 min of easy Zone 2 to finish."/>
        </SteadyState>
        <Cooldown Duration="480" PowerLow="0.55" PowerHigh="0.40">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
