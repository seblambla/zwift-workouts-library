<workout_file>
    <author>Coach Library</author>
    <name>VO2max L02A - 5x3 @ 108%</name>
    <description>VO2max - level 2 of 10, variant A. 5x3 @ 108%.

Structure: 12 min warm-up, 5 x (3 min @ 108% / 3 min @ 50%), 10 min @ 60%, 8 min cool-down.

Coach notes: Five 3-minute intervals. Go out fast and settle - no fade in the last minute.

Estimated TSS: 52.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="VO2max"/>
        <tag name="Level 2"/>
    </tags>
    <workout>
        <Warmup Duration="720" PowerLow="0.45" PowerHigh="0.75">
            <textevent timeoffset="0" message="VO2max session. Warm up thoroughly and add two 15 s accelerations in the last 3 minutes."/>
        </Warmup>
        <IntervalsT Repeat="5" OnDuration="180" OffDuration="180" OnPower="1.08" OffPower="0.50">
            <textevent timeoffset="0" message="GO! 3 min at 108%. Commit from the first pedal stroke."/>
        </IntervalsT>
        <SteadyState Duration="600" Power="0.60">
            <textevent timeoffset="0" message="Main set done. 10 min of easy Zone 2 to finish."/>
        </SteadyState>
        <Cooldown Duration="480" PowerLow="0.55" PowerHigh="0.40">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
