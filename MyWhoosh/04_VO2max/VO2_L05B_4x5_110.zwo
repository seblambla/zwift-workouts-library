<workout_file>
    <author>Coach Library</author>
    <name>VO2max L05B - 4x5 @ 110%</name>
    <description>VO2max - level 5 of 10, variant B. 4x5 @ 110%.

Structure: 12 min warm-up, 4 x (5 min @ 110% / 5 min @ 50%), 8 min cool-down.

Coach notes: Four 5-minute intervals. Long VO2 work - the last 90 s of each is a fight.

Estimated TSS: 59.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="VO2max"/>
        <tag name="Level 5"/>
    </tags>
    <workout>
        <Warmup Duration="720" PowerLow="0.45" PowerHigh="0.75">
            <textevent timeoffset="0" message="VO2max session. Warm up thoroughly and add two 15 s accelerations in the last 3 minutes."/>
        </Warmup>
        <IntervalsT Repeat="4" OnDuration="300" OffDuration="300" OnPower="1.10" OffPower="0.50">
            <textevent timeoffset="0" message="GO! 5 min at 110%. Commit from the first pedal stroke."/>
        </IntervalsT>
        <Cooldown Duration="480" PowerLow="0.55" PowerHigh="0.40">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
