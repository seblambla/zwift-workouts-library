<workout_file>
    <author>Coach Library</author>
    <name>Over-Unders L05A - 3x9 (93/105) 2+1</name>
    <description>Over-Unders - level 5 of 10, variant A. 3x9 (93/105) 2+1.

Structure: 10 min warm-up, 3 x (2 min under @ 93% / 1 min over @ 105%), 4 min @ 55%, 3 x (2 min under @ 93% / 1 min over @ 105%), 4 min @ 55%, 3 x (2 min under @ 93% / 1 min over @ 105%), 10 min @ 60%, 5 min cool-down.

Coach notes: The classic protocol: 2 min at 93%, 1 min at 105%. The over creates lactate, the under trains your body to clear it while still working - never coast after an over.

Estimated TSS: 62.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Over-Under"/>
        <tag name="Level 5"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.80">
            <textevent timeoffset="0" message="Over-under session. Warm up properly - the first block starts at the top of sweet spot."/>
        </Warmup>
        <IntervalsT Repeat="3" OnDuration="120" OffDuration="60" OnPower="0.93" OffPower="1.05">
            <textevent timeoffset="0" message="UNDER: 2 min at 93%. Hold it - this is still work, no coasting."/>
        </IntervalsT>
        <SteadyState Duration="240" Power="0.55">
            <textevent timeoffset="0" message="Recover: 4 min easy. Drink."/>
        </SteadyState>
        <IntervalsT Repeat="3" OnDuration="120" OffDuration="60" OnPower="0.93" OffPower="1.05">
            <textevent timeoffset="0" message="UNDER: 2 min at 93%. Hold it - this is still work, no coasting."/>
        </IntervalsT>
        <SteadyState Duration="240" Power="0.55">
            <textevent timeoffset="0" message="Recover: 4 min easy. Drink."/>
        </SteadyState>
        <IntervalsT Repeat="3" OnDuration="120" OffDuration="60" OnPower="0.93" OffPower="1.05">
            <textevent timeoffset="0" message="UNDER: 2 min at 93%. Hold it - this is still work, no coasting."/>
        </IntervalsT>
        <SteadyState Duration="600" Power="0.60">
            <textevent timeoffset="0" message="Main set done. 10 min of easy Zone 2 to finish."/>
        </SteadyState>
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
