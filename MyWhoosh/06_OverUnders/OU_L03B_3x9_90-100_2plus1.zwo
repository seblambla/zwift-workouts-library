<workout_file>
    <author>Coach Library</author>
    <name>Over-Unders L03B - 3x9 (90/100) 2+1</name>
    <description>Over-Unders - level 3 of 10, variant B. 3x9 (90/100) 2+1.

Structure: 10 min warm-up, 3 x (2 min under @ 90% / 1 min over @ 100%), 4 min @ 55%, 3 x (2 min under @ 90% / 1 min over @ 100%), 4 min @ 55%, 3 x (2 min under @ 90% / 1 min over @ 100%), 10 min @ 60%, 5 min cool-down.

Coach notes: 2 min under at 90%, 1 min over at FTP. The first time the over hits 100%. The over creates lactate, the under trains your body to clear it while still working - never coast after an over.

Estimated TSS: 58.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Over-Under"/>
        <tag name="Level 3"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.80">
            <textevent timeoffset="0" message="Over-under session. Warm up properly - the first block starts at the top of sweet spot."/>
        </Warmup>
        <IntervalsT Repeat="3" OnDuration="120" OffDuration="60" OnPower="0.90" OffPower="1.00">
            <textevent timeoffset="0" message="UNDER: 2 min at 90%. Hold it - this is still work, no coasting."/>
        </IntervalsT>
        <SteadyState Duration="240" Power="0.55">
            <textevent timeoffset="0" message="Recover: 4 min easy. Drink."/>
        </SteadyState>
        <IntervalsT Repeat="3" OnDuration="120" OffDuration="60" OnPower="0.90" OffPower="1.00">
            <textevent timeoffset="0" message="UNDER: 2 min at 90%. Hold it - this is still work, no coasting."/>
        </IntervalsT>
        <SteadyState Duration="240" Power="0.55">
            <textevent timeoffset="0" message="Recover: 4 min easy. Drink."/>
        </SteadyState>
        <IntervalsT Repeat="3" OnDuration="120" OffDuration="60" OnPower="0.90" OffPower="1.00">
            <textevent timeoffset="0" message="UNDER: 2 min at 90%. Hold it - this is still work, no coasting."/>
        </IntervalsT>
        <SteadyState Duration="600" Power="0.60">
            <textevent timeoffset="0" message="Main set done. 10 min of easy Zone 2 to finish."/>
        </SteadyState>
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
