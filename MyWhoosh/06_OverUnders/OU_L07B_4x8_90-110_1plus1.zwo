<workout_file>
    <author>Coach Library</author>
    <name>Over-Unders L07B - 4x8 (90/110) 1+1</name>
    <description>Over-Unders - level 7 of 10, variant B. 4x8 (90/110) 1+1.

Structure: 10 min warm-up, 4 x (1 min under @ 90% / 1 min over @ 110%), 3 min @ 55%, 4 x (1 min under @ 90% / 1 min over @ 110%), 3 min @ 55%, 4 x (1 min under @ 90% / 1 min over @ 110%), 3 min @ 55%, 4 x (1 min under @ 90% / 1 min over @ 110%), 4 min @ 60%, 5 min cool-down.

Coach notes: Overs at 110% - VO2max territory - with unders at 90%. Four blocks. The over creates lactate, the under trains your body to clear it while still working - never coast after an over.

Estimated TSS: 70.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Over-Under"/>
        <tag name="Level 7"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.80">
            <textevent timeoffset="0" message="Over-under session. Warm up properly - the first block starts at the top of sweet spot."/>
        </Warmup>
        <IntervalsT Repeat="4" OnDuration="60" OffDuration="60" OnPower="0.90" OffPower="1.10">
            <textevent timeoffset="0" message="UNDER: 1 min at 90%. Hold it - this is still work, no coasting."/>
        </IntervalsT>
        <SteadyState Duration="180" Power="0.55">
            <textevent timeoffset="0" message="Recover: 3 min easy. Drink."/>
        </SteadyState>
        <IntervalsT Repeat="4" OnDuration="60" OffDuration="60" OnPower="0.90" OffPower="1.10">
            <textevent timeoffset="0" message="UNDER: 1 min at 90%. Hold it - this is still work, no coasting."/>
        </IntervalsT>
        <SteadyState Duration="180" Power="0.55">
            <textevent timeoffset="0" message="Recover: 3 min easy. Drink."/>
        </SteadyState>
        <IntervalsT Repeat="4" OnDuration="60" OffDuration="60" OnPower="0.90" OffPower="1.10">
            <textevent timeoffset="0" message="UNDER: 1 min at 90%. Hold it - this is still work, no coasting."/>
        </IntervalsT>
        <SteadyState Duration="180" Power="0.55">
            <textevent timeoffset="0" message="Recover: 3 min easy. Drink."/>
        </SteadyState>
        <IntervalsT Repeat="4" OnDuration="60" OffDuration="60" OnPower="0.90" OffPower="1.10">
            <textevent timeoffset="0" message="UNDER: 1 min at 90%. Hold it - this is still work, no coasting."/>
        </IntervalsT>
        <SteadyState Duration="240" Power="0.60">
            <textevent timeoffset="0" message="Main set done. 4 min of easy Zone 2 to finish."/>
        </SteadyState>
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
