<workout_file>
    <author>Coach Library</author>
    <name>Over-Unders L08B - Pyramid 4-8-10-8-4 (90 / 105-115)</name>
    <description>Over-Unders - level 8 of 10, variant B. Pyramid 4-8-10-8-4 (90 / 105-115).

Structure: 10 min warm-up, 2 x (1 min under @ 90% / 1 min over @ 105%), 2:30 @ 55%, 4 x (1 min under @ 90% / 1 min over @ 110%), 2:30 @ 55%, 5 x (1 min under @ 90% / 1 min over @ 115%), 2:30 @ 55%, 4 x (1 min under @ 90% / 1 min over @ 110%), 2:30 @ 55%, 2 x (1 min under @ 90% / 1 min over @ 105%), 6 min cool-down.

Coach notes: Overs rise from 105% to 115% at the peak, unders at 90%. The 10-minute block is the crux. The over creates lactate, the under trains your body to clear it while still working - never coast after an over.

Estimated TSS: 72.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Over-Under"/>
        <tag name="Level 8"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.80">
            <textevent timeoffset="0" message="Over-under session. Warm up properly - the first block starts at the top of sweet spot."/>
        </Warmup>
        <IntervalsT Repeat="2" OnDuration="60" OffDuration="60" OnPower="0.90" OffPower="1.05">
            <textevent timeoffset="0" message="UNDER: 1 min at 90%. Hold it - this is still work, no coasting."/>
        </IntervalsT>
        <SteadyState Duration="150" Power="0.55">
            <textevent timeoffset="0" message="Recover: 2:30 easy. Drink."/>
        </SteadyState>
        <IntervalsT Repeat="4" OnDuration="60" OffDuration="60" OnPower="0.90" OffPower="1.10">
            <textevent timeoffset="0" message="UNDER: 1 min at 90%. Hold it - this is still work, no coasting."/>
        </IntervalsT>
        <SteadyState Duration="150" Power="0.55">
            <textevent timeoffset="0" message="Recover: 2:30 easy. Drink."/>
        </SteadyState>
        <IntervalsT Repeat="5" OnDuration="60" OffDuration="60" OnPower="0.90" OffPower="1.15">
            <textevent timeoffset="0" message="UNDER: 1 min at 90%. Hold it - this is still work, no coasting."/>
        </IntervalsT>
        <SteadyState Duration="150" Power="0.55">
            <textevent timeoffset="0" message="Recover: 2:30 easy. Drink."/>
        </SteadyState>
        <IntervalsT Repeat="4" OnDuration="60" OffDuration="60" OnPower="0.90" OffPower="1.10">
            <textevent timeoffset="0" message="UNDER: 1 min at 90%. Hold it - this is still work, no coasting."/>
        </IntervalsT>
        <SteadyState Duration="150" Power="0.55">
            <textevent timeoffset="0" message="Recover: 2:30 easy. Drink."/>
        </SteadyState>
        <IntervalsT Repeat="2" OnDuration="60" OffDuration="60" OnPower="0.90" OffPower="1.05">
            <textevent timeoffset="0" message="UNDER: 1 min at 90%. Hold it - this is still work, no coasting."/>
        </IntervalsT>
        <Cooldown Duration="360" PowerLow="0.60" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
