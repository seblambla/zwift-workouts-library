<workout_file>
    <author>Coach Library</author>
    <name>Over-Unders L06B - 3x10 (90/105) 1+1</name>
    <description>Over-Unders - level 6 of 10, variant B. 3x10 (90/105) 1+1.

Structure: 10 min warm-up, 5 x (1 min under @ 90% / 1 min over @ 105%), 4 min @ 55%, 5 x (1 min under @ 90% / 1 min over @ 105%), 4 min @ 55%, 5 x (1 min under @ 90% / 1 min over @ 105%), 7 min @ 60%, 5 min cool-down.

Coach notes: Three blocks of ten 1-minute switches. The under at 90% must be held. The over creates lactate, the under trains your body to clear it while still working - never coast after an over.

Estimated TSS: 65.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Over-Under"/>
        <tag name="Level 6"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.80">
            <textevent timeoffset="0" message="Over-under session. Warm up properly - the first block starts at the top of sweet spot."/>
        </Warmup>
        <IntervalsT Repeat="5" OnDuration="60" OffDuration="60" OnPower="0.90" OffPower="1.05">
            <textevent timeoffset="0" message="UNDER: 1 min at 90%. Hold it - this is still work, no coasting."/>
        </IntervalsT>
        <SteadyState Duration="240" Power="0.55">
            <textevent timeoffset="0" message="Recover: 4 min easy. Drink."/>
        </SteadyState>
        <IntervalsT Repeat="5" OnDuration="60" OffDuration="60" OnPower="0.90" OffPower="1.05">
            <textevent timeoffset="0" message="UNDER: 1 min at 90%. Hold it - this is still work, no coasting."/>
        </IntervalsT>
        <SteadyState Duration="240" Power="0.55">
            <textevent timeoffset="0" message="Recover: 4 min easy. Drink."/>
        </SteadyState>
        <IntervalsT Repeat="5" OnDuration="60" OffDuration="60" OnPower="0.90" OffPower="1.05">
            <textevent timeoffset="0" message="UNDER: 1 min at 90%. Hold it - this is still work, no coasting."/>
        </IntervalsT>
        <SteadyState Duration="420" Power="0.60">
            <textevent timeoffset="0" message="Main set done. 7 min of easy Zone 2 to finish."/>
        </SteadyState>
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
