<workout_file>
    <author>Coach Library</author>
    <name>Sweet Spot L09B - 4x9 @ 94% short rest</name>
    <description>Sweet Spot - level 9 of 10, variant B. 4x9 @ 94% short rest.

Structure: 10 min warm-up, 4 x (9 min @ 94% / 2:15 @ 55%), 5 min cool-down.

Coach notes: Top of the zone with only 2.5-minute recoveries. Hard but repeatable.

Estimated TSS: 66.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Sweet Spot"/>
        <tag name="Level 9"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.75">
            <textevent timeoffset="0" message="Sweet spot session. Build the warm-up gradually."/>
        </Warmup>
        <IntervalsT Repeat="4" OnDuration="540" OffDuration="135" OnPower="0.94" OffPower="0.55">
            <textevent timeoffset="0" message="9 min at 94% - comfortably hard."/>
        </IntervalsT>
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
