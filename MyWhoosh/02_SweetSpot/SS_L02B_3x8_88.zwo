<workout_file>
    <author>Coach Library</author>
    <name>Sweet Spot L02B - 3x8 @ 88%</name>
    <description>Sweet Spot - level 2 of 10, variant B. 3x8 @ 88%.

Structure: 10 min warm-up, 3 x (8 min @ 88% / 4 min @ 55%), 9 min @ 60%, 5 min cool-down.

Coach notes: Three blocks of 8 minutes. Aim for identical power on all three.

Estimated TSS: 51.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Sweet Spot"/>
        <tag name="Level 2"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.75">
            <textevent timeoffset="0" message="Sweet spot session. Build the warm-up gradually."/>
        </Warmup>
        <IntervalsT Repeat="3" OnDuration="480" OffDuration="240" OnPower="0.88" OffPower="0.55">
            <textevent timeoffset="0" message="8 min at 88% - comfortably hard."/>
        </IntervalsT>
        <SteadyState Duration="540" Power="0.60">
            <textevent timeoffset="0" message="Main set done. 9 min of easy Zone 2 to finish."/>
        </SteadyState>
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
