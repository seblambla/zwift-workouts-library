<workout_file>
    <author>Coach Library</author>
    <name>Sweet Spot L06B - 3x12 @ 90%</name>
    <description>Sweet Spot - level 6 of 10, variant B. 3x12 @ 90%.

Structure: 10 min warm-up, 3 x (12 min @ 90% / 3 min @ 55%), 5 min cool-down.

Coach notes: 36 minutes of sweet spot in three blocks.

Estimated TSS: 62.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Sweet Spot"/>
        <tag name="Level 6"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.75">
            <textevent timeoffset="0" message="Sweet spot session. Build the warm-up gradually."/>
        </Warmup>
        <IntervalsT Repeat="3" OnDuration="720" OffDuration="180" OnPower="0.90" OffPower="0.55">
            <textevent timeoffset="0" message="12 min at 90% - comfortably hard."/>
        </IntervalsT>
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
