<workout_file>
    <author>Coach Library</author>
    <name>Sweet Spot L04B - 5x6 @ 90% short rest</name>
    <description>Sweet Spot - level 4 of 10, variant B. 5x6 @ 90% short rest.

Structure: 10 min warm-up, 5 x (6 min @ 90% / 2 min @ 55%), 5 min @ 60%, 5 min cool-down.

Coach notes: Short 2-minute recoveries: fatigue accumulates, the last two blocks feel harder.

Estimated TSS: 57.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Sweet Spot"/>
        <tag name="Level 4"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.75">
            <textevent timeoffset="0" message="Sweet spot session. Build the warm-up gradually."/>
        </Warmup>
        <IntervalsT Repeat="5" OnDuration="360" OffDuration="120" OnPower="0.90" OffPower="0.55">
            <textevent timeoffset="0" message="6 min at 90% - comfortably hard."/>
        </IntervalsT>
        <SteadyState Duration="300" Power="0.60">
            <textevent timeoffset="0" message="Main set done. 5 min of easy Zone 2 to finish."/>
        </SteadyState>
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
