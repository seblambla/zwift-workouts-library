<workout_file>
    <author>Coach Library</author>
    <name>Endurance 90 L04A - Z2 75 min @ 65%</name>
    <description>Endurance 90 minutes - level 4 of 10, variant A. Z2 75 min @ 65%.

Structure: 10 min warm-up, 75 min @ 65%, 5 min cool-down.

Coach notes: Mid Zone 2 for 75 minutes. The classic aerobic base ride. Eat 40-60 g of carbohydrate per hour on rides this long.

Estimated TSS: 60.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Endurance"/>
        <tag name="90 min"/>
        <tag name="Level 4"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.60">
            <textevent timeoffset="0" message="Long endurance ride: 90 minutes. Warm up easy and settle into a relaxed rhythm. Have food and drink within reach."/>
        </Warmup>
        <SteadyState Duration="4500" Power="0.65">
            <textevent timeoffset="0" message="75 min at 65% - steady Zone 2. Conversational pace."/>
        </SteadyState>
        <Cooldown Duration="300" PowerLow="0.58" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done - 90 minutes in the bank. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
