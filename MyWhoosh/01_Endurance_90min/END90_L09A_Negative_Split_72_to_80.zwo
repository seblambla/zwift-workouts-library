<workout_file>
    <author>Coach Library</author>
    <name>Endurance 90 L09A - Negative Split 72 to 80%</name>
    <description>Endurance 90 minutes - level 9 of 10, variant A. Negative Split 72 to 80%.

Structure: 10 min warm-up, 35 min @ 72%, 40 min @ 80%, 5 min cool-down.

Coach notes: 35 min Zone 2 then 40 min low tempo. The second part should feel like a deliberate step up. Eat 40-60 g of carbohydrate per hour on rides this long.

Estimated TSS: 80.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Endurance"/>
        <tag name="90 min"/>
        <tag name="Level 9"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.60">
            <textevent timeoffset="0" message="Long endurance ride: 90 minutes. Warm up easy and settle into a relaxed rhythm. Have food and drink within reach."/>
        </Warmup>
        <SteadyState Duration="2100" Power="0.72">
            <textevent timeoffset="0" message="35 min at 72% - steady Zone 2. Conversational pace."/>
        </SteadyState>
        <SteadyState Duration="2400" Power="0.80">
            <textevent timeoffset="0" message="Tempo: 40 min at 80%. Controlled, rhythmic, not hard."/>
        </SteadyState>
        <Cooldown Duration="300" PowerLow="0.58" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done - 90 minutes in the bank. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
