<workout_file>
    <author>Coach Library</author>
    <name>Endurance 90 L04B - Z2 Steps 58 to 72%</name>
    <description>Endurance 90 minutes - level 4 of 10, variant B. Z2 Steps 58 to 72%.

Structure: 10 min warm-up, 15 min @ 58%, 15 min @ 62%, 15 min @ 66%, 15 min @ 70%, 15 min @ 72%, 5 min cool-down.

Coach notes: Five 15-minute steps rising through Zone 2. Heart rate should rise only slightly per step. Eat 40-60 g of carbohydrate per hour on rides this long.

Estimated TSS: 61.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Endurance"/>
        <tag name="90 min"/>
        <tag name="Level 4"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.60">
            <textevent timeoffset="0" message="Long endurance ride: 90 minutes. Warm up easy and settle into a relaxed rhythm. Have food and drink within reach."/>
        </Warmup>
        <SteadyState Duration="900" Power="0.58">
            <textevent timeoffset="0" message="15 min at 58% - steady Zone 2. Conversational pace."/>
        </SteadyState>
        <SteadyState Duration="900" Power="0.62">
            <textevent timeoffset="0" message="15 min at 62% - steady Zone 2. Conversational pace."/>
        </SteadyState>
        <SteadyState Duration="900" Power="0.66">
            <textevent timeoffset="0" message="15 min at 66% - steady Zone 2. Conversational pace."/>
        </SteadyState>
        <SteadyState Duration="900" Power="0.70">
            <textevent timeoffset="0" message="15 min at 70% - steady Zone 2. Conversational pace."/>
        </SteadyState>
        <SteadyState Duration="900" Power="0.72">
            <textevent timeoffset="0" message="15 min at 72% - steady Zone 2. Conversational pace."/>
        </SteadyState>
        <Cooldown Duration="300" PowerLow="0.58" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done - 90 minutes in the bank. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
