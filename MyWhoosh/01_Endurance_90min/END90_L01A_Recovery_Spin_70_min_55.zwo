<workout_file>
    <author>Coach Library</author>
    <name>Endurance 90 L01A - Recovery Spin 70 min @ 55%</name>
    <description>Endurance 90 minutes - level 1 of 10, variant A. Recovery Spin 70 min @ 55%.

Structure: 10 min warm-up, 70 min @ 55%, 10 min cool-down.

Coach notes: Long but very easy. Finish fresher than you started; lower the bias if 55% feels like work. Eat 40-60 g of carbohydrate per hour on rides this long.

Estimated TSS: 43.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Endurance"/>
        <tag name="90 min"/>
        <tag name="Level 1"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.40" PowerHigh="0.52">
            <textevent timeoffset="0" message="Long endurance ride: 90 minutes. Warm up easy and settle into a relaxed rhythm. Have food and drink within reach."/>
        </Warmup>
        <SteadyState Duration="4200" Power="0.55">
            <textevent timeoffset="0" message="70 min at 55% - steady Zone 2. Conversational pace."/>
        </SteadyState>
        <Cooldown Duration="600" PowerLow="0.55" PowerHigh="0.40">
            <textevent timeoffset="0" message="Well done - 90 minutes in the bank. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
