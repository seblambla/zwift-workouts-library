<workout_file>
    <author>Coach Library</author>
    <name>Endurance 90 L10A - Low Tempo 75 min @ 78%</name>
    <description>Endurance 90 minutes - level 10 of 10, variant A. Low Tempo 75 min @ 78%.

Structure: 10 min warm-up, 75 min @ 78%, 5 min cool-down.

Coach notes: A full 75 minutes of low tempo. The bridge between endurance and sweet spot. Eat 40-60 g of carbohydrate per hour on rides this long.

Estimated TSS: 83.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Endurance"/>
        <tag name="90 min"/>
        <tag name="Level 10"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.60">
            <textevent timeoffset="0" message="Long endurance ride: 90 minutes. Warm up easy and settle into a relaxed rhythm. Have food and drink within reach."/>
        </Warmup>
        <SteadyState Duration="4500" Power="0.78">
            <textevent timeoffset="0" message="Tempo: 75 min at 78%. Controlled, rhythmic, not hard."/>
        </SteadyState>
        <Cooldown Duration="300" PowerLow="0.58" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done - 90 minutes in the bank. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
