<workout_file>
    <author>Coach Library</author>
    <name>Threshold L04B - 2x12 @ 98%</name>
    <description>Threshold - level 4 of 10, variant B. 2x12 @ 98%.

Structure: 10 min warm-up, 12 min @ 98%, 5 min @ 55%, 12 min @ 98%, 16 min @ 60%, 5 min cool-down.

Coach notes: Two 12-minute blocks at 98%. Breathe deep and stay smooth.

Estimated TSS: 60.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Threshold"/>
        <tag name="Level 4"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.80">
            <textevent timeoffset="0" message="Threshold session. Warm up properly - the main set starts hard."/>
        </Warmup>
        <SteadyState Duration="720" Power="0.98">
            <textevent timeoffset="0" message="12 min at 98% - threshold. Pace it like a time trial."/>
        </SteadyState>
