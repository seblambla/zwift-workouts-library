<workout_file>
    <author>Coach Library</author>
    <name>Threshold L05B - Over-Unders 3x9 (93/105)</name>
    <description>Threshold - level 5 of 10, variant B. Over-Unders 3x9 (93/105).

Structure: 10 min warm-up, 3 x (2 min @ 93% / 1 min @ 105%), 5 min @ 55%, 3 x (2 min @ 93% / 1 min @ 105%), 5 min @ 55%, 3 x (2 min @ 93% / 1 min @ 105%), 8 min @ 60%, 5 min cool-down.

Coach notes: 2 min under at 93%, 1 min over at 105%. Never coast after an over.

Estimated TSS: 61.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Threshold"/>
        <tag name="Level 5"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.80">
            <textevent timeoffset="0" message="Threshold session. Warm up properly - the main set starts hard."/>
        </Warmup>
        <IntervalsT Repeat="3" OnDuration="120" OffDuration="60" OnPower="0.93" OffPower="1.05">
            <textevent timeoffset="0" message="UNDER: 2 min at 93%. Hold it - this is still work."/>
        </IntervalsT>
        <SteadyState Duration="300" Power="0.55">
            <textevent timeoffset="0" message="Recover: 5 min easy. Drink."/>
        </SteadyState>
        <IntervalsT Repeat="3" OnDuration="120" OffDuration="60" OnPower="0.93" OffPower="1.05">
            <textevent timeoffset="0" message="UNDER: 2 min at 93%. Hold it - this is still work."/>
        </IntervalsT>
        <SteadyState Duration="300" Power="0.55">
            <textevent timeoffset="0" message="Recover: 5 min easy. Drink."/>
        </SteadyState>
        <IntervalsT Repeat="3" OnDuration="120" OffDuration="60" OnPower="0.93" OffPower="1.05">
            <textevent timeoffset="0" message="UNDER: 2 min at 93%. Hold it - this is still work."/>
        </IntervalsT>
        <SteadyState Duration="480" Power="0.60">
            <textevent timeoffset="0" message="Main set done. 8 min of easy Zone 2 to finish."/>
        </SteadyState>
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
