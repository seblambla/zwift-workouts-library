<workout_file>
    <author>Coach Library</author>
    <name>Threshold L05A - 3x9 @ 97%</name>
    <description>Threshold - level 5 of 10, variant A. 3x9 @ 97%.

Structure: 10 min warm-up, 3 x (9 min @ 97% / 4 min @ 55%), 6 min @ 60%, 5 min cool-down.

Coach notes: 27 minutes of threshold in three blocks.

Estimated TSS: 61.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Threshold"/>
        <tag name="Level 5"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.80">
            <textevent timeoffset="0" message="Threshold session. Warm up properly - the main set starts hard."/>
        </Warmup>
        <IntervalsT Repeat="3" OnDuration="540" OffDuration="240" OnPower="0.97" OffPower="0.55">
            <textevent timeoffset="0" message="9 min at 97%. Pace it like a time trial."/>
        </IntervalsT>
        <SteadyState Duration="360" Power="0.60">
            <textevent timeoffset="0" message="Main set done. 6 min of easy Zone 2 to finish."/>
        </SteadyState>
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
