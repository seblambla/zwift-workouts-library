<workout_file>
    <author>Coach Library</author>
    <name>Threshold L07A - 3x10 @ 100%</name>
    <description>Threshold - level 7 of 10, variant A. 3x10 @ 100%.

Structure: 10 min warm-up, 3 x (10 min @ 100% / 5 min @ 55%), 5 min cool-down.

Coach notes: 30 minutes at FTP. If you cannot finish the third block, your FTP is set too high.

Estimated TSS: 67.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Threshold"/>
        <tag name="Level 7"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.80">
            <textevent timeoffset="0" message="Threshold session. Warm up properly - the main set starts hard."/>
        </Warmup>
        <IntervalsT Repeat="3" OnDuration="600" OffDuration="300" OnPower="1.00" OffPower="0.55">
            <textevent timeoffset="0" message="10 min at 100%. Pace it like a time trial."/>
        </IntervalsT>
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
