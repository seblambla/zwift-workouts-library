<workout_file>
    <author>Coach Library</author>
    <name>Threshold L04A - 3x8 @ 98%</name>
    <description>Threshold - level 4 of 10, variant A. 3x8 @ 98%.

Structure: 10 min warm-up, 3 x (8 min @ 98% / 4 min @ 55%), 9 min @ 60%, 5 min cool-down.

Coach notes: Three blocks very close to FTP. The first 3 minutes should feel too easy.

Estimated TSS: 59.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Threshold"/>
        <tag name="Level 4"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.80">
            <textevent timeoffset="0" message="Threshold session. Warm up properly - the main set starts hard."/>
        </Warmup>
        <IntervalsT Repeat="3" OnDuration="480" OffDuration="240" OnPower="0.98" OffPower="0.55">
            <textevent timeoffset="0" message="8 min at 98%. Pace it like a time trial."/>
        </IntervalsT>
        <SteadyState Duration="540" Power="0.60">
            <textevent timeoffset="0" message="Main set done. 9 min of easy Zone 2 to finish."/>
        </SteadyState>
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
