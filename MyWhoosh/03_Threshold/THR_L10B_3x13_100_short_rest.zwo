<workout_file>
    <author>Coach Library</author>
    <name>Threshold L10B - 3x13 @ 100% short rest</name>
    <description>Threshold - level 10 of 10, variant B. 3x13 @ 100% short rest.

Structure: 10 min warm-up, 3 x (13 min @ 100% / 2 min @ 55%), 5 min cool-down.

Coach notes: 39 minutes at FTP with only 3-minute recoveries. The hardest threshold session in the library.

Estimated TSS: 77.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Threshold"/>
        <tag name="Level 10"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.80">
            <textevent timeoffset="0" message="Threshold session. Warm up properly - the main set starts hard."/>
        </Warmup>
        <IntervalsT Repeat="3" OnDuration="780" OffDuration="120" OnPower="1.00" OffPower="0.55">
            <textevent timeoffset="0" message="13 min at 100%. Pace it like a time trial."/>
        </IntervalsT>
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
