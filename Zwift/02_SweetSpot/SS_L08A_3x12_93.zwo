<workout_file>
    <author>Coach Library</author>
    <name>Sweet Spot L08A - 3x12 @ 93%</name>
    <description>Sweet Spot - level 8 of 10, variant A. 3x12 @ 93%.

Structure: 10 min warm-up, 3 x (12 min @ 93% / 3 min @ 55%), 5 min cool-down.

Coach notes: Top of the sweet spot zone. The last block will feel close to threshold.

Estimated TSS: 65.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Sweet Spot"/>
        <tag name="Level 8"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.75">
            <textevent timeoffset="0" message="Sweet spot session. Build the warm-up gradually."/>
            <textevent timeoffset="480" message="2 minutes to the main set. Lift the effort slightly."/>
        </Warmup>
        <IntervalsT Repeat="3" OnDuration="720" OffDuration="180" OnPower="0.93" OffPower="0.55">
            <textevent timeoffset="0" message="12 min at 93% - comfortably hard."/>
            <textevent timeoffset="360" message="Halfway. Breathe deep, relax the shoulders."/>
            <textevent timeoffset="660" message="Last minute - hold the number."/>
            <textevent timeoffset="720" message="Recover - easy spin."/>
        </IntervalsT>
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
