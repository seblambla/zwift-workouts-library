<workout_file>
    <author>Coach Library</author>
    <name>Sweet Spot L05A - 2x16 @ 90%</name>
    <description>Sweet Spot - level 5 of 10, variant A. 2x16 @ 90%.

Structure: 10 min warm-up, 16 min @ 90%, 5 min @ 55%, 16 min @ 90%, 8 min @ 60%, 5 min cool-down.

Coach notes: Two 16-minute blocks. Keep the second identical to the first.

Estimated TSS: 59.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Sweet Spot"/>
        <tag name="Level 5"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.75">
            <textevent timeoffset="0" message="Sweet spot session. Build the warm-up gradually."/>
            <textevent timeoffset="480" message="2 minutes to the main set. Lift the effort slightly."/>
        </Warmup>
        <SteadyState Duration="960" Power="0.90">
            <textevent timeoffset="0" message="16 min at 90% - sweet spot, comfortably hard."/>
            <textevent timeoffset="480" message="Halfway. Relax the hands and shoulders."/>
            <textevent timeoffset="900" message="Last minute - stay composed."/>
        </SteadyState>
        <SteadyState Duration="300" Power="0.55">
            <textevent timeoffset="0" message="Recover: 5 min easy. Drink."/>
        </SteadyState>
        <SteadyState Duration="960" Power="0.90">
            <textevent timeoffset="0" message="16 min at 90% - sweet spot, comfortably hard."/>
            <textevent timeoffset="480" message="Halfway. Relax the hands and shoulders."/>
            <textevent timeoffset="900" message="Last minute - stay composed."/>
        </SteadyState>
        <SteadyState Duration="480" Power="0.60">
            <textevent timeoffset="0" message="Main set done. 8 min of easy Zone 2 to finish."/>
        </SteadyState>
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
