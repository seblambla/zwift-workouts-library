<workout_file>
    <author>Coach Library</author>
    <name>Sweet Spot L01A - 2x10 @ 88%</name>
    <description>Sweet Spot - level 1 of 10, variant A. 2x10 @ 88%.

Structure: 10 min warm-up, 10 min @ 88%, 5 min @ 55%, 10 min @ 88%, 20 min @ 60%, 5 min cool-down.

Coach notes: First sweet spot session of a block. Even pacing, no fade in the last 2 minutes.

Estimated TSS: 49.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Sweet Spot"/>
        <tag name="Level 1"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.75">
            <textevent timeoffset="0" message="Sweet spot session. Build the warm-up gradually."/>
            <textevent timeoffset="480" message="2 minutes to the main set. Lift the effort slightly."/>
        </Warmup>
        <SteadyState Duration="600" Power="0.88">
            <textevent timeoffset="0" message="10 min at 88% - sweet spot, comfortably hard."/>
            <textevent timeoffset="300" message="Halfway. Relax the hands and shoulders."/>
            <textevent timeoffset="540" message="Last minute - stay composed."/>
        </SteadyState>
        <SteadyState Duration="300" Power="0.55">
            <textevent timeoffset="0" message="Recover: 5 min easy. Drink."/>
        </SteadyState>
        <SteadyState Duration="600" Power="0.88">
            <textevent timeoffset="0" message="10 min at 88% - sweet spot, comfortably hard."/>
            <textevent timeoffset="300" message="Halfway. Relax the hands and shoulders."/>
            <textevent timeoffset="540" message="Last minute - stay composed."/>
        </SteadyState>
        <SteadyState Duration="1200" Power="0.60">
            <textevent timeoffset="0" message="Main set done. 20 min of easy Zone 2 to finish."/>
        </SteadyState>
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
