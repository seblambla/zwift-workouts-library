<workout_file>
    <author>Coach Library</author>
    <name>Sweet Spot L03B - 3x10 @ 88%</name>
    <description>Sweet Spot - level 3 of 10, variant B. 3x10 @ 88%.

Structure: 10 min warm-up, 3 x (10 min @ 88% / 4 min @ 55%), 3 min @ 60%, 5 min cool-down.

Coach notes: 30 minutes of sweet spot in three blocks.

Estimated TSS: 55.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Sweet Spot"/>
        <tag name="Level 3"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.75">
            <textevent timeoffset="0" message="Sweet spot session. Build the warm-up gradually."/>
            <textevent timeoffset="480" message="2 minutes to the main set. Lift the effort slightly."/>
        </Warmup>
        <IntervalsT Repeat="3" OnDuration="600" OffDuration="240" OnPower="0.88" OffPower="0.55">
            <textevent timeoffset="0" message="10 min at 88% - comfortably hard."/>
            <textevent timeoffset="300" message="Halfway. Breathe deep, relax the shoulders."/>
            <textevent timeoffset="540" message="Last minute - hold the number."/>
            <textevent timeoffset="600" message="Recover - easy spin."/>
        </IntervalsT>
        <SteadyState Duration="180" Power="0.60">
            <textevent timeoffset="0" message="Main set done. 3 min of easy Zone 2 to finish."/>
        </SteadyState>
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
