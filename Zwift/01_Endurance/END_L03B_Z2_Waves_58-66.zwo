<workout_file>
    <author>Coach Library</author>
    <name>Endurance L03B - Z2 Waves 58-66%</name>
    <description>Endurance - level 3 of 10, variant B. Z2 Waves 58-66%.

Structure: 10 min warm-up, 5 x (4:30 @ 66% / 4:30 @ 58%), 5 min cool-down.

Coach notes: Rolling Zone 2: shift gears to change power, keep pedalling smoothly.

Estimated TSS: 36.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Endurance"/>
        <tag name="Level 3"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.60">
            <textevent timeoffset="0" message="Endurance ride. Warm up easy and settle into a relaxed rhythm."/>
            <textevent timeoffset="480" message="2 minutes to the main set. Lift the effort slightly."/>
        </Warmup>
        <IntervalsT Repeat="5" OnDuration="270" OffDuration="270" OnPower="0.66" OffPower="0.58">
            <textevent timeoffset="0" message="4:30 at 66%."/>
            <textevent timeoffset="210" message="Last minute - hold the number."/>
            <textevent timeoffset="270" message="Recover - easy spin."/>
        </IntervalsT>
        <Cooldown Duration="300" PowerLow="0.58" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
