<workout_file>
    <author>Coach Library</author>
    <name>Endurance L08B - Z2 + 4x5 Tempo @ 85%</name>
    <description>Endurance - level 8 of 10, variant B. Z2 + 4x5 Tempo @ 85%.

Structure: 10 min warm-up, 5 min @ 68%, 4 x (5 min @ 85% / 5 min @ 66%), 5 min cool-down.

Coach notes: Four tempo touches inside a Zone 2 ride. Controlled, never hard.

Estimated TSS: 49.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Endurance"/>
        <tag name="Level 8"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.60">
            <textevent timeoffset="0" message="Endurance ride. Warm up easy and settle into a relaxed rhythm."/>
            <textevent timeoffset="480" message="2 minutes to the main set. Lift the effort slightly."/>
        </Warmup>
        <SteadyState Duration="300" Power="0.68">
            <textevent timeoffset="0" message="5 min at 68% - steady Zone 2. Conversational pace."/>
        </SteadyState>
        <IntervalsT Repeat="4" OnDuration="300" OffDuration="300" OnPower="0.85" OffPower="0.66">
            <textevent timeoffset="0" message="Tempo: 5 min at 85%. Controlled, rhythmic."/>
            <textevent timeoffset="240" message="Last minute - hold the number."/>
            <textevent timeoffset="300" message="Recover - easy spin."/>
        </IntervalsT>
        <Cooldown Duration="300" PowerLow="0.58" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
