<workout_file>
    <author>Coach Library</author>
    <name>Endurance L04B - Z2 Steps 58 to 72%</name>
    <description>Endurance - level 4 of 10, variant B. Z2 Steps 58 to 72%.

Structure: 10 min warm-up, 9 min @ 58%, 9 min @ 62%, 9 min @ 66%, 9 min @ 70%, 9 min @ 72%, 5 min cool-down.

Coach notes: Five 9-minute steps rising through Zone 2. Heart rate should rise only slightly per step.

Estimated TSS: 39.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Endurance"/>
        <tag name="Level 4"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.60">
            <textevent timeoffset="0" message="Endurance ride. Warm up easy and settle into a relaxed rhythm."/>
            <textevent timeoffset="480" message="2 minutes to the main set. Lift the effort slightly."/>
        </Warmup>
        <SteadyState Duration="540" Power="0.58">
            <textevent timeoffset="0" message="9 min at 58% - steady Zone 2. Conversational pace."/>
        </SteadyState>
        <SteadyState Duration="540" Power="0.62">
            <textevent timeoffset="0" message="9 min at 62% - steady Zone 2. Conversational pace."/>
        </SteadyState>
        <SteadyState Duration="540" Power="0.66">
            <textevent timeoffset="0" message="9 min at 66% - steady Zone 2. Conversational pace."/>
        </SteadyState>
        <SteadyState Duration="540" Power="0.70">
            <textevent timeoffset="0" message="9 min at 70% - steady Zone 2. Conversational pace."/>
        </SteadyState>
        <SteadyState Duration="540" Power="0.72">
            <textevent timeoffset="0" message="9 min at 72% - steady Zone 2. Conversational pace."/>
        </SteadyState>
        <Cooldown Duration="300" PowerLow="0.58" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
