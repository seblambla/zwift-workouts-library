<workout_file>
    <author>Coach Library</author>
    <name>Endurance L09A - Negative Split 72 to 80%</name>
    <description>Endurance - level 9 of 10, variant A. Negative Split 72 to 80%.

Structure: 10 min warm-up, 20 min @ 72%, 25 min @ 80%, 5 min cool-down.

Coach notes: Zone 2 then low tempo. The second half should feel like a deliberate step up.

Estimated TSS: 51.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Endurance"/>
        <tag name="Level 9"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.60">
            <textevent timeoffset="0" message="Endurance ride. Warm up easy and settle into a relaxed rhythm."/>
            <textevent timeoffset="480" message="2 minutes to the main set. Lift the effort slightly."/>
        </Warmup>
        <SteadyState Duration="1200" Power="0.72">
            <textevent timeoffset="0" message="20 min at 72% - steady Zone 2. Conversational pace."/>
            <textevent timeoffset="600" message="Halfway. Check your position: relaxed shoulders, light grip."/>
        </SteadyState>
        <SteadyState Duration="1500" Power="0.80">
            <textevent timeoffset="0" message="Tempo: 25 min at 80%. Controlled, rhythmic, not hard."/>
            <textevent timeoffset="750" message="Halfway through this tempo block."/>
        </SteadyState>
        <Cooldown Duration="300" PowerLow="0.58" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
