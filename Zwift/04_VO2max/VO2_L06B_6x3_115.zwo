<workout_file>
    <author>Coach Library</author>
    <name>VO2max L06B - 6x3 @ 115%</name>
    <description>VO2max - level 6 of 10, variant B. 6x3 @ 115%.

Structure: 12 min warm-up, 6 x (3 min @ 115% / 3 min @ 50%), 4 min @ 60%, 8 min cool-down.

Coach notes: Six 3-minute intervals at 115%. Fast start, then hold.

Estimated TSS: 60.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="VO2max"/>
        <tag name="Level 6"/>
    </tags>
    <workout>
        <Warmup Duration="720" PowerLow="0.45" PowerHigh="0.75">
            <textevent timeoffset="0" message="VO2max session. Warm up thoroughly and add two 15 s accelerations in the last 3 minutes."/>
            <textevent timeoffset="600" message="2 minutes to the main set. Lift the effort slightly."/>
        </Warmup>
        <IntervalsT Repeat="6" OnDuration="180" OffDuration="180" OnPower="1.15" OffPower="0.50">
            <textevent timeoffset="0" message="GO! 3 min at 115%. Commit from the first pedal stroke."/>
            <textevent timeoffset="180" message="Recover - easy spin."/>
        </IntervalsT>
        <SteadyState Duration="240" Power="0.60">
            <textevent timeoffset="0" message="Main set done. 4 min of easy Zone 2 to finish."/>
        </SteadyState>
        <Cooldown Duration="480" PowerLow="0.55" PowerHigh="0.40">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
