<workout_file>
    <author>Coach Library</author>
    <name>VO2max L01B - 10x1 @ 115%</name>
    <description>VO2max - level 1 of 10, variant B. 10x1 @ 115%.

Structure: 12 min warm-up, 10 x (1 min @ 115% / 1:30 @ 50%), 15 min @ 60%, 8 min cool-down.

Coach notes: Short, sharp efforts with 90 s recovery. Commit from the first pedal stroke.

Estimated TSS: 48.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="VO2max"/>
        <tag name="Level 1"/>
    </tags>
    <workout>
        <Warmup Duration="720" PowerLow="0.45" PowerHigh="0.75">
            <textevent timeoffset="0" message="VO2max session. Warm up thoroughly and add two 15 s accelerations in the last 3 minutes."/>
            <textevent timeoffset="600" message="2 minutes to the main set. Lift the effort slightly."/>
        </Warmup>
        <IntervalsT Repeat="10" OnDuration="60" OffDuration="90" OnPower="1.15" OffPower="0.50">
            <textevent timeoffset="0" message="GO! 1 min at 115%. Commit from the first pedal stroke."/>
            <textevent timeoffset="60" message="Recover - easy spin."/>
        </IntervalsT>
        <SteadyState Duration="900" Power="0.60">
            <textevent timeoffset="0" message="Main set done. 15 min of easy Zone 2 to finish."/>
        </SteadyState>
        <Cooldown Duration="480" PowerLow="0.55" PowerHigh="0.40">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
