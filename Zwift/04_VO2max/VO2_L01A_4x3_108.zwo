<workout_file>
    <author>Coach Library</author>
    <name>VO2max L01A - 4x3 @ 108%</name>
    <description>VO2max - level 1 of 10, variant A. 4x3 @ 108%.

Structure: 12 min warm-up, 4 x (3 min @ 108% / 3 min @ 50%), 16 min @ 60%, 8 min cool-down.

Coach notes: Gentle introduction to VO2max work. Breathing should be hard by the end of each interval.

Estimated TSS: 48.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="VO2max"/>
        <tag name="Level 1"/>
    </tags>
    <workout>
        <Warmup Duration="720" PowerLow="0.45" PowerHigh="0.75">
            <textevent timeoffset="0" message="VO2max session. Warm up thoroughly and add two 15 s accelerations in the last 3 minutes."/>
            <textevent timeoffset="600" message="2 minutes to the main set. Lift the effort slightly."/>
        </Warmup>
        <IntervalsT Repeat="4" OnDuration="180" OffDuration="180" OnPower="1.08" OffPower="0.50">
            <textevent timeoffset="0" message="GO! 3 min at 108%. Commit from the first pedal stroke."/>
            <textevent timeoffset="180" message="Recover - easy spin."/>
        </IntervalsT>
        <SteadyState Duration="960" Power="0.60">
            <textevent timeoffset="0" message="Main set done. 16 min of easy Zone 2 to finish."/>
        </SteadyState>
        <Cooldown Duration="480" PowerLow="0.55" PowerHigh="0.40">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
