<workout_file>
    <author>Coach Library</author>
    <name>VO2max L09A - 5x5 @ 112%</name>
    <description>VO2max - level 9 of 10, variant A. 5x5 @ 112%.

Structure: 10 min warm-up, 5 x (5 min @ 112% / 3:30 @ 50%), 1:30 @ 60%, 6 min cool-down.

Coach notes: Five 5-minute intervals with short recoveries. A big VO2max dose.

Estimated TSS: 69.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="VO2max"/>
        <tag name="Level 9"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.75">
            <textevent timeoffset="0" message="VO2max session. Warm up thoroughly and add two 15 s accelerations in the last 3 minutes."/>
            <textevent timeoffset="480" message="2 minutes to the main set. Lift the effort slightly."/>
        </Warmup>
        <IntervalsT Repeat="5" OnDuration="300" OffDuration="210" OnPower="1.12" OffPower="0.50">
            <textevent timeoffset="0" message="GO! 5 min at 112%. Commit from the first pedal stroke."/>
            <textevent timeoffset="240" message="Last minute - hold the number."/>
            <textevent timeoffset="300" message="Recover - easy spin."/>
        </IntervalsT>
        <SteadyState Duration="90" Power="0.60">
            <textevent timeoffset="0" message="Main set done. 1:30 of easy Zone 2 to finish."/>
        </SteadyState>
        <Cooldown Duration="360" PowerLow="0.55" PowerHigh="0.40">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
