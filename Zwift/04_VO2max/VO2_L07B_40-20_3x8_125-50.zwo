<workout_file>
    <author>Coach Library</author>
    <name>VO2max L07B - 40/20 3x8 (125/50)</name>
    <description>VO2max - level 7 of 10, variant B. 40/20 3x8 (125/50).

Structure: 12 min warm-up, 8 x (40 s @ 125% / 20 s @ 50%), 5 min @ 55%, 8 x (40 s @ 125% / 20 s @ 50%), 5 min @ 55%, 8 x (40 s @ 125% / 20 s @ 50%), 6 min @ 60%, 8 min cool-down.

Coach notes: Three sets of eight 40/20s. The 20 s rest is too short to recover - that is the point.

Estimated TSS: 64.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="VO2max"/>
        <tag name="Level 7"/>
    </tags>
    <workout>
        <Warmup Duration="720" PowerLow="0.45" PowerHigh="0.75">
            <textevent timeoffset="0" message="VO2max session. Warm up thoroughly and add two 15 s accelerations in the last 3 minutes."/>
            <textevent timeoffset="600" message="2 minutes to the main set. Lift the effort slightly."/>
        </Warmup>
        <IntervalsT Repeat="8" OnDuration="40" OffDuration="20" OnPower="1.25" OffPower="0.50">
            <textevent timeoffset="0" message="GO! 40 s at 125%. Commit from the first pedal stroke."/>
            <textevent timeoffset="40" message="Recover - easy spin."/>
        </IntervalsT>
        <SteadyState Duration="300" Power="0.55">
            <textevent timeoffset="0" message="Recover: 5 min easy. Drink."/>
        </SteadyState>
        <IntervalsT Repeat="8" OnDuration="40" OffDuration="20" OnPower="1.25" OffPower="0.50">
            <textevent timeoffset="0" message="GO! 40 s at 125%. Commit from the first pedal stroke."/>
            <textevent timeoffset="40" message="Recover - easy spin."/>
        </IntervalsT>
        <SteadyState Duration="300" Power="0.55">
            <textevent timeoffset="0" message="Recover: 5 min easy. Drink."/>
        </SteadyState>
        <IntervalsT Repeat="8" OnDuration="40" OffDuration="20" OnPower="1.25" OffPower="0.50">
            <textevent timeoffset="0" message="GO! 40 s at 125%. Commit from the first pedal stroke."/>
            <textevent timeoffset="40" message="Recover - easy spin."/>
        </IntervalsT>
        <SteadyState Duration="360" Power="0.60">
            <textevent timeoffset="0" message="Main set done. 6 min of easy Zone 2 to finish."/>
        </SteadyState>
        <Cooldown Duration="480" PowerLow="0.55" PowerHigh="0.40">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
