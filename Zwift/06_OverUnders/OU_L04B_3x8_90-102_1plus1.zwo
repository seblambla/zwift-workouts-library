<workout_file>
    <author>Coach Library</author>
    <name>Over-Unders L04B - 3x8 (90/102) 1+1</name>
    <description>Over-Unders - level 4 of 10, variant B. 3x8 (90/102) 1+1.

Structure: 10 min warm-up, 4 x (1 min under @ 90% / 1 min over @ 102%), 4 min @ 55%, 4 x (1 min under @ 90% / 1 min over @ 102%), 4 min @ 55%, 4 x (1 min under @ 90% / 1 min over @ 102%), 13 min @ 60%, 5 min cool-down.

Coach notes: Overs just above FTP, unders at 90%. Equal 1-minute phases. The over creates lactate, the under trains your body to clear it while still working - never coast after an over.

Estimated TSS: 58.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Over-Under"/>
        <tag name="Level 4"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.80">
            <textevent timeoffset="0" message="Over-under session. Warm up properly - the first block starts at the top of sweet spot."/>
            <textevent timeoffset="480" message="2 minutes to the first block. Lift the effort slightly."/>
        </Warmup>
        <IntervalsT Repeat="4" OnDuration="60" OffDuration="60" OnPower="0.90" OffPower="1.02">
            <textevent timeoffset="0" message="UNDER: 1 min at 90%. Hold it - this is still work, no coasting."/>
            <textevent timeoffset="60" message="OVER: 1 min at 102%. Push, then settle straight back to the under."/>
        </IntervalsT>
        <SteadyState Duration="240" Power="0.55">
            <textevent timeoffset="0" message="Recover: 4 min easy. Drink."/>
        </SteadyState>
        <IntervalsT Repeat="4" OnDuration="60" OffDuration="60" OnPower="0.90" OffPower="1.02">
            <textevent timeoffset="0" message="UNDER: 1 min at 90%. Hold it - this is still work, no coasting."/>
            <textevent timeoffset="60" message="OVER: 1 min at 102%. Push, then settle straight back to the under."/>
        </IntervalsT>
        <SteadyState Duration="240" Power="0.55">
            <textevent timeoffset="0" message="Recover: 4 min easy. Drink."/>
        </SteadyState>
        <IntervalsT Repeat="4" OnDuration="60" OffDuration="60" OnPower="0.90" OffPower="1.02">
            <textevent timeoffset="0" message="UNDER: 1 min at 90%. Hold it - this is still work, no coasting."/>
            <textevent timeoffset="60" message="OVER: 1 min at 102%. Push, then settle straight back to the under."/>
        </IntervalsT>
        <SteadyState Duration="780" Power="0.60">
            <textevent timeoffset="0" message="Main set done. 13 min of easy Zone 2 to finish."/>
        </SteadyState>
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
