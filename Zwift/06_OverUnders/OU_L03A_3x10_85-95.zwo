<workout_file>
    <author>Coach Library</author>
    <name>Over-Unders L03A - 3x10 (85/95)</name>
    <description>Over-Unders - level 3 of 10, variant A. 3x10 (85/95).

Structure: 10 min warm-up, 5 x (1 min under @ 85% / 1 min over @ 95%), 4 min @ 55%, 5 x (1 min under @ 85% / 1 min over @ 95%), 4 min @ 55%, 5 x (1 min under @ 85% / 1 min over @ 95%), 7 min @ 60%, 5 min cool-down.

Coach notes: The light over-under classic: 30 minutes total, under at 85%. The over creates lactate, the under trains your body to clear it while still working - never coast after an over.

Estimated TSS: 58.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Over-Under"/>
        <tag name="Level 3"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.80">
            <textevent timeoffset="0" message="Over-under session. Warm up properly - the first block starts at the top of sweet spot."/>
            <textevent timeoffset="480" message="2 minutes to the first block. Lift the effort slightly."/>
        </Warmup>
        <IntervalsT Repeat="5" OnDuration="60" OffDuration="60" OnPower="0.85" OffPower="0.95">
            <textevent timeoffset="0" message="UNDER: 1 min at 85%. Hold it - this is still work, no coasting."/>
            <textevent timeoffset="60" message="OVER: 1 min at 95%. Push, then settle straight back to the under."/>
        </IntervalsT>
        <SteadyState Duration="240" Power="0.55">
            <textevent timeoffset="0" message="Recover: 4 min easy. Drink."/>
        </SteadyState>
        <IntervalsT Repeat="5" OnDuration="60" OffDuration="60" OnPower="0.85" OffPower="0.95">
            <textevent timeoffset="0" message="UNDER: 1 min at 85%. Hold it - this is still work, no coasting."/>
            <textevent timeoffset="60" message="OVER: 1 min at 95%. Push, then settle straight back to the under."/>
        </IntervalsT>
        <SteadyState Duration="240" Power="0.55">
            <textevent timeoffset="0" message="Recover: 4 min easy. Drink."/>
        </SteadyState>
        <IntervalsT Repeat="5" OnDuration="60" OffDuration="60" OnPower="0.85" OffPower="0.95">
            <textevent timeoffset="0" message="UNDER: 1 min at 85%. Hold it - this is still work, no coasting."/>
            <textevent timeoffset="60" message="OVER: 1 min at 95%. Push, then settle straight back to the under."/>
        </IntervalsT>
        <SteadyState Duration="420" Power="0.60">
            <textevent timeoffset="0" message="Main set done. 7 min of easy Zone 2 to finish."/>
        </SteadyState>
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
