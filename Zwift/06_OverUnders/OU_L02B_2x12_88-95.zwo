<workout_file>
    <author>Coach Library</author>
    <name>Over-Unders L02B - 2x12 (88/95)</name>
    <description>Over-Unders - level 2 of 10, variant B. 2x12 (88/95).

Structure: 10 min warm-up, 6 x (1 min under @ 88% / 1 min over @ 95%), 5 min @ 55%, 6 x (1 min under @ 88% / 1 min over @ 95%), 16 min @ 60%, 5 min cool-down.

Coach notes: Two longer blocks with the under in sweet spot. The over creates lactate, the under trains your body to clear it while still working - never coast after an over.

Estimated TSS: 55.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Over-Under"/>
        <tag name="Level 2"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.80">
            <textevent timeoffset="0" message="Over-under session. Warm up properly - the first block starts at the top of sweet spot."/>
            <textevent timeoffset="480" message="2 minutes to the first block. Lift the effort slightly."/>
        </Warmup>
        <IntervalsT Repeat="6" OnDuration="60" OffDuration="60" OnPower="0.88" OffPower="0.95">
            <textevent timeoffset="0" message="UNDER: 1 min at 88%. Hold it - this is still work, no coasting."/>
            <textevent timeoffset="60" message="OVER: 1 min at 95%. Push, then settle straight back to the under."/>
        </IntervalsT>
        <SteadyState Duration="300" Power="0.55">
            <textevent timeoffset="0" message="Recover: 5 min easy. Drink."/>
        </SteadyState>
        <IntervalsT Repeat="6" OnDuration="60" OffDuration="60" OnPower="0.88" OffPower="0.95">
            <textevent timeoffset="0" message="UNDER: 1 min at 88%. Hold it - this is still work, no coasting."/>
            <textevent timeoffset="60" message="OVER: 1 min at 95%. Push, then settle straight back to the under."/>
        </IntervalsT>
        <SteadyState Duration="960" Power="0.60">
            <textevent timeoffset="0" message="Main set done. 16 min of easy Zone 2 to finish."/>
        </SteadyState>
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
