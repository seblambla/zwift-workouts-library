<workout_file>
    <author>Coach Library</author>
    <name>Mixed L08B - Over-Under Pyramid 4-6-8-6-4</name>
    <description>Mixed - level 8 of 10, variant B. Over-Under Pyramid 4-6-8-6-4.

Structure: 10 min warm-up, 2 x (1 min @ 105% / 1 min @ 90%), 3 min @ 55%, 3 x (1 min @ 110% / 1 min @ 90%), 3 min @ 55%, 4 x (1 min @ 115% / 1 min @ 90%), 3 min @ 55%, 3 x (1 min @ 110% / 1 min @ 90%), 3 min @ 55%, 2 x (1 min @ 105% / 1 min @ 90%), 5 min @ 60%, 5 min cool-down.

Coach notes: Overs rise from 105% to 115% at the peak, unders at 90%. The 8-minute block is the crux.

Estimated TSS: 65.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Mixed"/>
        <tag name="Level 8"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.75">
            <textevent timeoffset="0" message="Mixed session today. Warm up progressively."/>
            <textevent timeoffset="480" message="2 minutes to the main set. Lift the effort slightly."/>
        </Warmup>
        <IntervalsT Repeat="2" OnDuration="60" OffDuration="60" OnPower="1.05" OffPower="0.90">
            <textevent timeoffset="0" message="OVER: 1 min at 105%. Push, then settle back without stopping."/>
            <textevent timeoffset="60" message="UNDER: 1 min at 90%. Keep working, no coasting."/>
        </IntervalsT>
        <SteadyState Duration="180" Power="0.55">
            <textevent timeoffset="0" message="Recover: 3 min easy. Drink."/>
        </SteadyState>
        <IntervalsT Repeat="3" OnDuration="60" OffDuration="60" OnPower="1.10" OffPower="0.90">
            <textevent timeoffset="0" message="OVER: 1 min at 110%. Push, then settle back without stopping."/>
            <textevent timeoffset="60" message="UNDER: 1 min at 90%. Keep working, no coasting."/>
        </IntervalsT>
        <SteadyState Duration="180" Power="0.55">
            <textevent timeoffset="0" message="Recover: 3 min easy. Drink."/>
        </SteadyState>
        <IntervalsT Repeat="4" OnDuration="60" OffDuration="60" OnPower="1.15" OffPower="0.90">
            <textevent timeoffset="0" message="OVER: 1 min at 115%. Push, then settle back without stopping."/>
            <textevent timeoffset="60" message="UNDER: 1 min at 90%. Keep working, no coasting."/>
        </IntervalsT>
        <SteadyState Duration="180" Power="0.55">
            <textevent timeoffset="0" message="Recover: 3 min easy. Drink."/>
        </SteadyState>
        <IntervalsT Repeat="3" OnDuration="60" OffDuration="60" OnPower="1.10" OffPower="0.90">
            <textevent timeoffset="0" message="OVER: 1 min at 110%. Push, then settle back without stopping."/>
            <textevent timeoffset="60" message="UNDER: 1 min at 90%. Keep working, no coasting."/>
        </IntervalsT>
        <SteadyState Duration="180" Power="0.55">
            <textevent timeoffset="0" message="Recover: 3 min easy. Drink."/>
        </SteadyState>
        <IntervalsT Repeat="2" OnDuration="60" OffDuration="60" OnPower="1.05" OffPower="0.90">
            <textevent timeoffset="0" message="OVER: 1 min at 105%. Push, then settle back without stopping."/>
            <textevent timeoffset="60" message="UNDER: 1 min at 90%. Keep working, no coasting."/>
        </IntervalsT>
        <SteadyState Duration="300" Power="0.60">
            <textevent timeoffset="0" message="Main set done. 5 min of easy Zone 2 to finish."/>
        </SteadyState>
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
