<workout_file>
    <author>Coach Library</author>
    <name>Mixed L08A - Race Simulation</name>
    <description>Mixed - level 8 of 10, variant A. Race Simulation.

Structure: 10 min warm-up, 5 min @ 72%, 1 min @ 140%, 3 min @ 105%, 5 min @ 88%, 1:30 @ 130%, 8 min @ 97%, 4 min @ 65%, 30 s @ 150%, 2:30 @ 102%, 4 min @ 65%, 1 min @ 120%, 20 s @ 160%, 4:40 @ 50%, 4:30 @ 60%, 5 min cool-down.

Coach notes: Neutral rollout, attack, chase, breakaway, counter, lead-out, sprint. React to each cue immediately.

Estimated TSS: 65.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Mixed"/>
        <tag name="Level 8"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.75">
            <textevent timeoffset="0" message="Mixed session today. Warm up progressively."/>
            <textevent timeoffset="480" message="2 minutes to the main set. Lift the effort slightly."/>
        </Warmup>
        <SteadyState Duration="300" Power="0.72">
            <textevent timeoffset="0" message="Recover: 5 min easy. Drink."/>
        </SteadyState>
        <SteadyState Duration="60" Power="1.40">
            <textevent timeoffset="0" message="ATTACK! 1 min at 140%!"/>
        </SteadyState>
        <SteadyState Duration="180" Power="1.05">
            <textevent timeoffset="0" message="3 min at 105% - threshold. Pace it like a time trial."/>
        </SteadyState>
        <SteadyState Duration="300" Power="0.88">
            <textevent timeoffset="0" message="5 min at 88% - sweet spot, comfortably hard."/>
            <textevent timeoffset="240" message="Last minute - stay composed."/>
        </SteadyState>
        <SteadyState Duration="90" Power="1.30">
            <textevent timeoffset="0" message="ATTACK! 1:30 at 130%!"/>
        </SteadyState>
        <SteadyState Duration="480" Power="0.97">
            <textevent timeoffset="0" message="8 min at 97% - threshold. Pace it like a time trial."/>
            <textevent timeoffset="240" message="Halfway. Stay smooth."/>
            <textevent timeoffset="420" message="Last minute - hold the number."/>
        </SteadyState>
        <SteadyState Duration="240" Power="0.65">
            <textevent timeoffset="0" message="Recover: 4 min easy. Drink."/>
        </SteadyState>
        <SteadyState Duration="30" Power="1.50">
            <textevent timeoffset="0" message="ATTACK! 30 s at 150%!"/>
        </SteadyState>
        <SteadyState Duration="150" Power="1.02">
            <textevent timeoffset="0" message="2:30 at 102% - threshold. Pace it like a time trial."/>
        </SteadyState>
        <SteadyState Duration="240" Power="0.65">
            <textevent timeoffset="0" message="Recover: 4 min easy. Drink."/>
        </SteadyState>
        <SteadyState Duration="60" Power="1.20">
            <textevent timeoffset="0" message="ATTACK! 1 min at 120%!"/>
        </SteadyState>
        <SteadyState Duration="20" Power="1.60">
            <textevent timeoffset="0" message="ATTACK! 20 s at 160%!"/>
        </SteadyState>
        <SteadyState Duration="280" Power="0.50">
            <textevent timeoffset="0" message="Recover: 4:40 easy. Drink."/>
        </SteadyState>
        <SteadyState Duration="270" Power="0.60">
            <textevent timeoffset="0" message="Main set done. 4:30 of easy Zone 2 to finish."/>
        </SteadyState>
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
