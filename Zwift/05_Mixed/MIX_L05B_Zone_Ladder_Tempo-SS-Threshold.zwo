<workout_file>
    <author>Coach Library</author>
    <name>Mixed L05B - Zone Ladder Tempo-SS-Threshold</name>
    <description>Mixed - level 5 of 10, variant B. Zone Ladder Tempo-SS-Threshold.

Structure: 10 min warm-up, 10 min @ 85%, 4 min @ 55%, 10 min @ 90%, 4 min @ 55%, 8 min @ 100%, 9 min @ 60%, 5 min cool-down.

Coach notes: 10 min tempo, 10 min sweet spot, 8 min threshold. Each step changes the sensation.

Estimated TSS: 57.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Mixed"/>
        <tag name="Level 5"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.75">
            <textevent timeoffset="0" message="Mixed session today. Warm up progressively."/>
            <textevent timeoffset="480" message="2 minutes to the main set. Lift the effort slightly."/>
        </Warmup>
        <SteadyState Duration="600" Power="0.85">
            <textevent timeoffset="0" message="Tempo: 10 min at 85%. Controlled, rhythmic, not hard."/>
            <textevent timeoffset="300" message="Halfway through this tempo block."/>
        </SteadyState>
        <SteadyState Duration="240" Power="0.55">
            <textevent timeoffset="0" message="Recover: 4 min easy. Drink."/>
        </SteadyState>
        <SteadyState Duration="600" Power="0.90">
            <textevent timeoffset="0" message="10 min at 90% - sweet spot, comfortably hard."/>
            <textevent timeoffset="300" message="Halfway. Relax the hands and shoulders."/>
            <textevent timeoffset="540" message="Last minute - stay composed."/>
        </SteadyState>
        <SteadyState Duration="240" Power="0.55">
            <textevent timeoffset="0" message="Recover: 4 min easy. Drink."/>
        </SteadyState>
        <SteadyState Duration="480" Power="1.00">
            <textevent timeoffset="0" message="8 min at 100% - threshold. Pace it like a time trial."/>
            <textevent timeoffset="240" message="Halfway. Stay smooth."/>
            <textevent timeoffset="420" message="Last minute - hold the number."/>
        </SteadyState>
        <SteadyState Duration="540" Power="0.60">
            <textevent timeoffset="0" message="Main set done. 9 min of easy Zone 2 to finish."/>
        </SteadyState>
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
