<workout_file>
    <author>Coach Library</author>
    <name>Threshold L09B - 2x20 @ 97%</name>
    <description>Threshold - level 9 of 10, variant B. 2x20 @ 97%.

Structure: 10 min warm-up, 20 min @ 97%, 5 min @ 55%, 20 min @ 97%, 5 min cool-down.

Coach notes: The classic 2x20 just under threshold. Patience in the first 10 minutes.

Estimated TSS: 74.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Threshold"/>
        <tag name="Level 9"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.80">
            <textevent timeoffset="0" message="Threshold session. Warm up properly - the main set starts hard."/>
            <textevent timeoffset="480" message="2 minutes to the main set. Lift the effort slightly."/>
        </Warmup>
        <SteadyState Duration="1200" Power="0.97">
            <textevent timeoffset="0" message="20 min at 97% - threshold. Pace it like a time trial."/>
            <textevent timeoffset="600" message="Halfway. Stay smooth."/>
            <textevent timeoffset="1140" message="Last minute - hold the number."/>
        </SteadyState>
        <SteadyState Duration="300" Power="0.55">
            <textevent timeoffset="0" message="Recover: 5 min easy. Drink."/>
        </SteadyState>
        <SteadyState Duration="1200" Power="0.97">
            <textevent timeoffset="0" message="20 min at 97% - threshold. Pace it like a time trial."/>
            <textevent timeoffset="600" message="Halfway. Stay smooth."/>
            <textevent timeoffset="1140" message="Last minute - hold the number."/>
        </SteadyState>
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
