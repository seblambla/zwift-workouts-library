<workout_file>
    <author>Coach Library</author>
    <name>Threshold L01B - 2x8 @ 95%</name>
    <description>Threshold - level 1 of 10, variant B. 2x8 @ 95%.

Structure: 10 min warm-up, 8 min @ 95%, 5 min @ 55%, 8 min @ 95%, 24 min @ 60%, 5 min cool-down.

Coach notes: Two 8-minute blocks just under FTP. Start controlled.

Estimated TSS: 50.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Threshold"/>
        <tag name="Level 1"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.80">
            <textevent timeoffset="0" message="Threshold session. Warm up properly - the main set starts hard."/>
            <textevent timeoffset="480" message="2 minutes to the main set. Lift the effort slightly."/>
        </Warmup>
        <SteadyState Duration="480" Power="0.95">
            <textevent timeoffset="0" message="8 min at 95% - threshold. Pace it like a time trial."/>
            <textevent timeoffset="240" message="Halfway. Stay smooth."/>
            <textevent timeoffset="420" message="Last minute - hold the number."/>
        </SteadyState>
        <SteadyState Duration="300" Power="0.55">
            <textevent timeoffset="0" message="Recover: 5 min easy. Drink."/>
        </SteadyState>
        <SteadyState Duration="480" Power="0.95">
            <textevent timeoffset="0" message="8 min at 95% - threshold. Pace it like a time trial."/>
            <textevent timeoffset="240" message="Halfway. Stay smooth."/>
            <textevent timeoffset="420" message="Last minute - hold the number."/>
        </SteadyState>
        <SteadyState Duration="1440" Power="0.60">
            <textevent timeoffset="0" message="Main set done. 24 min of easy Zone 2 to finish."/>
        </SteadyState>
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
