<workout_file>
    <author>Coach Library</author>
    <name>Endurance 90 L09B - Tempo 4x10 @ 84%</name>
    <description>Endurance 90 minutes - level 9 of 10, variant B. Tempo 4x10 @ 84%.

Structure: 10 min warm-up, 3 min @ 68%, 4 x (10 min @ 84% / 8 min @ 65%), 5 min cool-down.

Coach notes: Four tempo blocks with Zone 2 recoveries. Rhythmic and controlled. Eat 40-60 g of carbohydrate per hour on rides this long.

Estimated TSS: 79.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Endurance"/>
        <tag name="90 min"/>
        <tag name="Level 9"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.60">
            <textevent timeoffset="0" message="Long endurance ride: 90 minutes. Warm up easy and settle into a relaxed rhythm. Have food and drink within reach."/>
            <textevent timeoffset="480" message="2 minutes to the main set."/>
        </Warmup>
        <SteadyState Duration="180" Power="0.68">
            <textevent timeoffset="0" message="3 min at 68% - easy. Drink."/>
        </SteadyState>
        <IntervalsT Repeat="4" OnDuration="600" OffDuration="480" OnPower="0.84" OffPower="0.65">
            <textevent timeoffset="0" message="Tempo: 10 min at 84%. Controlled, rhythmic, not hard."/>
            <textevent timeoffset="300" message="Halfway through this tempo block."/>
            <textevent timeoffset="600" message="Back to Zone 2 at 65%. Let the heart rate drift down. Drink."/>
        </IntervalsT>
        <Cooldown Duration="300" PowerLow="0.58" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done - 90 minutes in the bank. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
